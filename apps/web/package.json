{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prisma:generate": "node scripts/gen-migrations-manifest.mjs && prisma generate",
    "build": "node scripts/gen-migrations-manifest.mjs && prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "NODE_OPTIONS=--conditions=react-server node ../../node_modules/tsx/dist/cli.mjs --test tests/*.test.ts",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:status": "prisma migrate status",
    "db:baseline": "prisma migrate resolve --applied 20260505060106_init_postgres_with_slider",
    "db:seed": "prisma db seed",
    "db:reset": "prisma migrate reset",
    "db:studio": "prisma studio",
    "admin:make": "tsx scripts/make-admin.ts"
  },
  "prisma": {
    "seed": "npx tsx prisma/seed.ts"
  },
  "dependencies": {
    "@google/genai": "^2.27.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@react-email/components": "^1.0.12",
    "@tailwindcss/typography": "^0.5.20",
    "@tiptap/extensions": "^3.31.4",
    "@tiptap/pm": "^3.31.4",
    "@tiptap/react": "^3.31.4",
    "@tiptap/starter-kit": "^3.31.4",
    "@upstash/qstash": "^2.12.0",
    "@vercel/blob": "^2.8.1",
    "better-auth": "^1.7.7",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "dom-serializer": "^3.1.1",
    "domhandler": "^6.0.1",
    "dotenv": "^18.0.5",
    "framer-motion": "^12.43.0",
    "googleapis": "^183.0.0",
    "htmlparser2": "^12.0.0",
    "lucide-react": "^1.52.0",
    "next": "^16.3.8",
    "next-themes": "^0.4.6",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "resend": "^6.32.0",
    "rss-parser": "^3.13.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "svix": "^2.7.0",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5"
