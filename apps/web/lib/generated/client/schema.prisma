generator client {
  provider      = "prisma-client-js"
  output        = "../lib/generated/client"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
  engineType    = "library"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                   String            @id @default(cuid())
  name                 String
  email                String            @unique
  emailVerified        Boolean           @default(false)
  image                String?
  role                 String            @default("USER")
  bio                  String?
  newsletterSubscribed Boolean           @default(false)
  newsletterTime       String            @default("08:00")
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  accounts             Account[]
  articles             Article[]
  bookmarks            Bookmark[]
  comments             Comment[]
  media                Media[]
  reactions            ArticleReaction[]
  reads                ArticleRead[]
  sessions             Session[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id                    String    @id @default(cuid())
  userId                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  idToken               String?
  password              String?
  issuer                String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Aynı sağlayıcı hesabı yalnızca bir kez bağlanabilir (better-auth 1.7.7 bunu varsayar)
  @@unique([providerId, accountId])
  @@index([userId])
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Article {
  id              String    @id @default(cuid())
  title           String
  slug            String    @unique
  content         String
  excerpt         String?
  coverImage      String?
  status          String    @default("DRAFT")
  viewCount       Int       @default(0)
  authorId        String
  categoryId      String?
  aiPersonaId     String?
  sourceRssItemId String?   @unique
  publishedAt     DateTime?
  lang            String    @default("tr")

  // Analiz Sonuclari
  plagiarismRate   Int?
  seoScore         Int?
  readabilityScore Int?
  qualityScore     Int?
  analysisReport   Json?

  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt
  author        User                     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  category      Category?                @relation(fields: [categoryId], references: [id])
  aiPersona     AiPersona?               @relation(fields: [aiPersonaId], references: [id], onDelete: SetNull)
  sourceRssItem RssFeedItem?             @relation(fields: [sourceRssItemId], references: [id], onDelete: SetNull)
  story         NewsStory?               @relation("StoryArticle")
  bookmarks     Bookmark[]
  comments      Comment[]
  reactions     ArticleReaction[]
  reads         ArticleRead[]
  tags          TagOnArticle[]
  /// Türkçe tam metin arama dizini. Veritabanı tetikleyicisi doldurur (migration 20261014090000_article_search);
  /// uygulama kodu bu alana yazmaz.
  searchVector  Unsupported("tsvector")?

  @@index([authorId])
  @@index([categoryId])
  @@index([status])
  @@index([publishedAt])
  @@index([slug])
  @@index([lang])
  @@index([aiPersonaId])
  @@index([searchVector], type: Gin)
}

model Category {
  id          String                @id @default(cuid())
  name        String                @unique
  slug        String                @unique
  description String?
  color       String?
  icon        String?
  order       Int                   @default(0)
  lang        String                @default("tr")
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  articles    Article[]
  personas    AiPersonaOnCategory[]
}

model Tag {
  id        String         @id @default(cuid())
  name      String         @unique
  slug      String         @unique
  lang      String         @default("tr")
  createdAt DateTime       @default(now())
  articles  TagOnArticle[]
}

model TagOnArticle {
  articleId String
  tagId     String
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([articleId, tagId])
  @@index([tagId])
}

model Comment {
  id        String    @id @default(cuid())
  content   String
  userId    String
  articleId String
  parentId  String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  article   Article   @relation(fields: [articleId], references: [id], onDelete: Cascade)
  parent    Comment?  @relation("CommentReplies", fields: [parentId], references: [id])
  replies   Comment[] @relation("CommentReplies")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([articleId])
  @@index([userId])
  @@index([parentId])
}

/// Okur tepkileri: kişi başına (kullanıcı veya anonim ziyaretçi) haber başına tek tepki
model ArticleReaction {
  id        String   @id @default(cuid())
  articleId String
  /// like | insightful | surprised | applause | angry
  type      String
  userId    String?
  /// Giriş yapmamış okurlar için çerezdeki rastgele kimlik
  visitorId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([articleId, userId])
  @@unique([articleId, visitorId])
  @@index([articleId, type])
}

/// Giriş yapmış okurun okuma geçmişi: ne kadarını okuduğu ve sonuna kadar okuyup okumadığı
model ArticleRead {
  id          String    @id @default(cuid())
  userId      String
  articleId   String
  /// 0-100, hiç geriye düşmez
  progress    Int       @default(0)
  /// Haberin sonuna (tepkiler bölümüne) ulaşıldığı an
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  article     Article   @relation(fields: [articleId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, articleId])
  @@index([userId, updatedAt])
}

model Bookmark {
  id        String   @id @default(cuid())
  userId    String
  articleId String
  createdAt DateTime @default(now())
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, articleId])
  @@index([userId])
}

model Subscriber {
  id               String   @id @default(cuid())
  email            String   @unique
  isActive         Boolean  @default(true)
  newsletterTime   String   @default("08:00")
  unsubscribeToken String   @unique @default(cuid())
  createdAt        DateTime @default(now())
  /// Son durum değişikliği (onay / abonelikten çıkma); pasif kayıtların saklama süresi buradan sayılır
  updatedAt        DateTime @default(now()) @updatedAt
}

model Media {
  id        String      @id @default(cuid())
  url       String      @unique
  filename  String
  size      Int
  mimeType  String
  status    MediaStatus @default(RAW)
  width     Int?
  height    Int?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
}

model StaticPage {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  description String?
  content     String
  extraData   Json?
  lang        String   @default("tr")
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  @@index([slug])
}

model SupportTicket {
  id        String           @id @default(cuid())
  subject   String
  userEmail String
  userName  String?
  status    String           @default("OPEN")
  priority  String           @default("NORMAL")
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  messages  SupportMessage[]

  @@index([userEmail])
  @@index([status])
  @@index([createdAt])
}

model SupportMessage {
  id          String        @id @default(cuid())
  ticketId    String
  sender      String
  direction   String
  content     String
  attachments Json?
  createdAt   DateTime      @default(now())
  ticket      SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@index([createdAt])
}

enum MediaStatus {
  RAW
  PROCESSING
  OPTIMIZED
  FAILED
}

/// Yönetici tarafından eklenen RSS kaynakları
model RssFeedSource {
  id            String        @id @default(cuid())
  name          String // Örn: "BBC News TR"
  url           String        @unique // RSS feed URL
  categoryHint  String? // Öneri kategori eşleşmesi
  language      String        @default("tr")
  isActive      Boolean       @default(true)
  lastFetchedAt DateTime?
  fetchError    String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  items         RssFeedItem[]

  @@index([isActive])
}

/// RSS'ten çekilen ham haberler
model RssFeedItem {
  id               String            @id @default(cuid())
  sourceId         String
  title            String
  url              String            @unique
  urlHash          String            @unique // SHA-256 hash, hızlı dedup
  excerpt          String?
  imageUrl         String?
  publishedAt      DateTime?
  status           RssItemStatus     @default(PENDING)
  aiScore          Int? // 0-100 Gemini öneri puanı
  aiAnalysis       Json? // Gemini'nin tam JSON çıktısı
  dismissed        Boolean           @default(false) // "İlginç değil" işareti
  usedForArticle   Boolean           @default(false) // Bu öneriden haber yazıldıysa
  processingAt     DateTime?
  processingToken  String?           @unique
  /// Bu haberin ait olduğu konu (aynı olayı anlatan haberler tek konuda toplanır)
  storyId          String?
  story            NewsStory?        @relation(fields: [storyId], references: [id], onDelete: SetNull)
  source           RssFeedSource     @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  googleTrendItems GoogleTrendItem[]
  article          Article?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([sourceId])
  @@index([status])
  @@index([aiScore])
  @@index([publishedAt])
  @@index([dismissed])
  @@index([usedForArticle])
  @@index([storyId])
}

/// Karar Merkezi: aynı olayı anlatan RSS haberlerinin kümesi. Puanlanır, sıraya girer ve en fazla bir kez haberleştirilir.
model NewsStory {
  id                 String        @id @default(cuid())
  /// Temsilci başlık (kaynaklardan)
  title              String
  /// Yapay zekânın önerdiği özgün başlık
  headline           String?
  summary            String?
  /// Benzerlik için başlık kökleri ve özel isimler
  tokens             String[]
  entities           String[]
  categoryName       String?
  status             StoryStatus   @default(NEW)
  urgency            StoryUrgency  @default(NORMAL)
  /// Nihai öncelik puanı (0-100) ve bileşenleri
  score              Int           @default(0)
  aiScore            Int?
  trendScore         Int           @default(0)
  trendKeyword       String?
  sourceCount        Int           @default(1)
  itemCount          Int           @default(1)
  firstSeenAt        DateTime      @default(now())
  lastSeenAt         DateTime      @default(now())
  /// Planlı olay zamanı (maç, toplantı) ve haberin geçerliliğini yitirdiği an
  eventAt            DateTime?
  expiresAt          DateTime?
  pinned             Boolean       @default(false)
  /// Durumun okunur açıklaması (ör. "Aynı haber zaten yayında")
  reason             String?
  analysis           Json?
  analyzedAt         DateTime?
  /// Devam haberi ise önceki makale; tekrar ise eşleştiği makale
  relatedArticleId   String?
  duplicateArticleId String?
  articleId          String?       @unique
  article            Article?      @relation("StoryArticle", fields: [articleId], references: [id], onDelete: SetNull)
  attempts           Int           @default(0)
  lastError          String?
  processingAt       DateTime?
  processingToken    String?       @unique
  items              RssFeedItem[]
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@index([status, score])
  @@index([lastSeenAt])
  @@index([expiresAt])
}

enum StoryStatus {
  NEW // Analiz bekliyor
  READY // Puanlandı; puanı eşiği geçerse yazım sırasında
  WRITING // AI Yazar şu an yazıyor
  PUBLISHED // Haberleştirildi
  DUPLICATE // Aynı haber zaten yayında
  LOW_SCORE // Haber değeri düşük
  EXPIRED // Güncelliğini yitirdi
  DISMISSED // Editör eledi
  FAILED // Yazım tekrar tekrar başarısız oldu
}

enum StoryUrgency {
  BREAKING // Son dakika
  TIME_SENSITIVE // Belirli bir zamana bağlı (maç, toplantı, karar)
  NORMAL
  EVERGREEN // Güncelliğini uzun süre korur
}

enum RssItemStatus {
  PENDING // Henüz AI analizi yapılmadı
  ANALYZED // Gemini analiz etti, puan verildi
  APPROVED // Admin onayladı, yazar masasına düştü
  LOW_SCORE // Puan düşük (< 40), gösterilmeyecek
  COVERED // Zaten haberleştirilmiş konuyla örtüşüyor
  EXPIRED_STALE // Tarihi geçmiş / güncelliğini yitirmiş haber
  DISMISSED // Yazar/admin "gerek yok" dedi
}

/// Sistem genel ayarları ve aktif QStash Cron görev ID'leri
model SystemSettings {
  id                 String  @id @default("global") // Her zaman tek satır olacak
  rssScanCron        String  @default("0 */2 * * *") // 2 saatte bir
  rssAnalyzeCron     String  @default("0 */4 * * *") // 4 saatte bir
  rssRetentionDays   Int     @default(14) // Eski öğeler kaç gün saklansın
  qStashScanId       String? // QStash üzerindeki görev ID'si
  qStashAnalyzeId    String?
  qStashNewsletterId String? // QStash Newsletter Task ID

  // AI Sağlayıcısı (OPENROUTER veya GOOGLE)
  aiProvider String @default("OPENROUTER")

  // AI Analiz ve Özet Modeli (RSS Puanlama & Özetleme). Biçim: "sağlayıcı:model"
  aiAnalyzerModel  String  @default("google:gemini-3.5-flash-lite")
  /// RSS haberlerini puanlarken uygulanacak editoryal kriterler (boşsa varsayılan)
  aiAnalyzerPrompt String? @db.Text
  /// Haber seslendirme modeli (yalnızca Google)
  aiTtsModel       String  @default("google:gemini-3.8-flash-tts")

  // AI Writer Ayarları
  aiWriterModel       String  @default("google:gemini-3.8-flash")
  aiWriterImageModel  String  @default("google:gemini-3.1-flash-image")
  aiWriterPrompt      String  @default("Sen profesyonel bir haber editörüsün. Verilen konuyu Google Arama kullanarak araştır ve en güncel, doğru bilgilerle son derece kaliteli, özgün ve tarafsız bir haber makalesi yaz. HTML formatında (h2, p, strong etiketlerini kullanarak) döndür. Başlık dahil etme.")
  aiWriterImagePrompt String  @default("Profesyonel, gerçekçi bir haber fotoğrafı. Fotoğrafçılık kalitesinde, 16:9 oranında, haberin konusuyla ilgili.")
  aiWriterUseRssImage Boolean @default(true)

  // AI Writer Otomasyonu
  aiWriterAutoEnabled   Boolean @default(false)
  aiWriterAutoCount     Int     @default(3)
  aiWriterAutoCron      String  @default("0 */6 * * *") // 6 saatte bir
  qStashAiWriterId      String? // QStash üzerindeki görev ID'si
  aiWriterSearchEnabled Boolean @default(false)

  // Maksimum Haber Yaşı ve Google Trends Ayarları
  maxNewsAgeHours            Int     @default(24) // Kaç saatten eski haberler elensin (0 = kapalı)
  googleTrendsEnabled        Boolean @default(true) // Google Trends entegrasyonu aktif mi
  googleTrendsGeo            String  @default("TR") // Bölge kodu ("TR", "US" vb.)
  trendAutoPublishThreshold  Int     @default(70) // Trend eşleşme skoru kaç üzerindeyse öncelikli otomatik yayın
  trendSearchGenerateEnabled Boolean @default(true) // Trends'te olup RSS'te olmayan konu için aramayla haber üret
  /// Karar Merkezi: bu puanın altındaki konular otomatik yazılmaz
  storyMinScore              Int     @default(60)

  updatedAt DateTime @updatedAt
}

enum TrendAction {
  PENDING
  AUTO_PUBLISHED
  SEARCH_GENERATED
  SCHEDULED_DRAFT
  DISMISSED
}

/// Google Trends Verileri
model GoogleTrend {
  id           String            @id @default(cuid())
  keyword      String            @unique
  searchVolume String?
  exploreUrl   String?
  category     String?
  country      String            @default("TR")
  trafficScore Int               @default(50)
  items        GoogleTrendItem[]
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([keyword])
  @@index([trafficScore])
  @@index([country])
}

/// Trends ile RSS Karşılaştırma Eşleşmesi
model GoogleTrendItem {
  id          String       @id @default(cuid())
  trendId     String
  rssItemId   String?
  matchScore  Int
  actionTaken TrendAction  @default(PENDING)
  trend       GoogleTrend  @relation(fields: [trendId], references: [id], onDelete: Cascade)
  rssItem     RssFeedItem? @relation(fields: [rssItemId], references: [id], onDelete: SetNull)
  createdAt   DateTime     @default(now())

  @@index([trendId])
  @@index([rssItemId])
  @@index([matchScore])
}

/// AI Yazar Personaları (Farklı kategoriler için farklı yazım ve görsel stilleri)
model AiPersona {
  id          String                @id @default(cuid())
  name        String                @unique // "Caner KÖSE" vb.
  role        String?               @default("Haber Editörü")
  image       String? // Profil resmi URL
  description String?
  prompt      String                @db.Text
  imagePrompt String                @db.Text
  isActive    Boolean               @default(true)
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  categories  AiPersonaOnCategory[]
  articles    Article[]
}

model AiPersonaOnCategory {
  personaId  String
  categoryId String
  lastUsedAt DateTime? @default(now())
  persona    AiPersona @relation(fields: [personaId], references: [id], onDelete: Cascade)
  category   Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([personaId, categoryId])
}

/// Platform marka ve görünüm ayarları (Singleton - id her zaman "global")
model SiteSettings {
  id                String   @id @default("global")
  siteName          String   @default("Haber Nexus")
  siteTagline       String?  @default("Yeni Nesil Haber Platformu")
  siteDescription   String?  @default("Gündemdeki en son haberleri, analizleri ve derinlemesine içerikleri keşfedin. Modern, hızlı ve kişiselleştirilmiş haber deneyimi.")
  siteUrl           String?
  logoText          String?  @default("N")
  logoUrl           String?
  faviconUrl        String?
  primaryColorLight String?
  primaryColorDark  String?
  bgLight           String?
  bgDark            String?
  fgLight           String?
  fgDark            String?
  cardLight         String?
  cardDark          String?
  cardFgLight       String?
  cardFgDark        String?
  accentLight       String?
  accentDark        String?
  sidebarBgLight    String?
  sidebarBgDark     String?
  sidebarFgLight    String?
  sidebarFgDark     String?
  keywords          String?  @default("haber,gündem,son dakika,analiz,Türkiye,dünya,teknoloji,spor")
  socialTwitter     String?
  socialInstagram   String?
  socialYoutube     String?
  socialGithub      String?
  footerCopyright   String?
  updatedAt         DateTime @updatedAt
  createdAt         DateTime @default(now())
}

enum AiModelType {
  TEXT
  IMAGE
  MULTIMODAL
}

model AiModel {
  id          String      @id // OpenRouter model ID (örn: "openai/gpt-4")
  name        String
  description String?     @db.Text
  type        AiModelType @default(TEXT)
  isFree      Boolean     @default(false)
  isActive    Boolean     @default(true)

  // Yetenekler ve Modaliteler
  inputModalities  Json? // ["text", "image"]
  outputModalities Json? // ["text", "image"]
  supportsSearch   Boolean @default(false)
  supportsVision   Boolean @default(false)
  supportsT2I      Boolean @default(false)
  supportsI2I      Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Slider {
  id           String   @id @default("homepage") // Use "homepage" as default ID for the main slider
  name         String   @unique
  autoPlay     Boolean  @default(true)
  interval     Int      @default(5000)
  height       String?  @default("500px")
  mobileHeight String?  @default("300px")
  isActive     Boolean  @default(true)
  slides       Slide[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Slide {
  id          String    @id @default(cuid())
  title       String?
  description String?
  imageUrl    String
  link        String?
  order       Int       @default(0)
  isActive    Boolean   @default(true)
  startTime   DateTime?
  endTime     DateTime?
  sliderId    String
  slider      Slider    @relation(fields: [sliderId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([sliderId])
  @@index([order])
}

/// Reklam ve ölçüm ayarları (tek satır, id="global"). Kimlikler herkese açık değerlerdir; gizli anahtar tutulmaz.
model MonetizationSettings {
  id                     String   @id @default("global")
  gaEnabled              Boolean  @default(false)
  gaMeasurementId        String?
  vercelAnalyticsEnabled Boolean  @default(false)
  adsenseEnabled         Boolean  @default(false)
  adsensePublisherId     String?
  /// ads.txt'ye eklenecek ek satırlar (başka reklam ağları)
  adsTxtExtra            String?
  /// Reklam alanı → { mode: off | sponsor | adsense | auto, adsenseSlot?: string }
  placements             Json     @default("{}")
  updatedAt              DateTime @updatedAt
}

/// Doğrudan satılan (sponsor) reklamlar
model SponsorAd {
  id             String    @id @default(cuid())
  name           String
  advertiser     String?
  imageUrl       String
  /// Geniş alanlarda telefon için ayrı görsel (isteğe bağlı)
  imageUrlMobile String?
  linkUrl        String
  altText        String
  /// Gösterileceği reklam alanları (lib/monetization.ts → PLACEMENTS)
  placements     String[]
  isActive       Boolean   @default(true)
  startsAt       DateTime  @default(now())
  endsAt         DateTime?
  /// Aynı alanda birden çok sponsor varsa gösterim payı
  weight         Int       @default(1)
  impressions    Int       @default(0)
  clicks         Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([isActive, startsAt])
}

/// Görüntülenme tekilleştirme: aynı kişi aynı haberi günde bir kez sayılır. id, kişi + haber + günden
/// türetilen tek yönlü özettir (IP veya kullanıcı kimliği saklanmaz); 2 günden eski kayıtlar silinir.
model ArticleViewMark {
  id        String   @id
  createdAt DateTime @default(now())

  @@index([createdAt])
}
